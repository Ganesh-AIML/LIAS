JWT_SECRET_KEY=replace_with_a_strong_random_secret
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# MongoDB Atlas connection (migration target; Neon DATABASE_URL stays the source of truth)
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/lias
ADMIN_SECRET=replace_with_64_char_hex_secret
# Staff account auth (module-based authorization):
# ADMIN_EMAIL/ADMIN_PASSWORD seed the first admin on startup — ONLY while zero
# admin accounts exist. Until then, ADMIN_SECRET (X-Admin-Token) stays valid.
ADMIN_EMAIL=replace_with_admin_email
ADMIN_PASSWORD=replace_with_a_strong_admin_password
DB_ENCRYPTION_KEY=replace_with_a_fernet_compatible_key
ALLOWED_ORIGINS=https://your-frontend.onrender.com,http://localhost:5173
JWT_EXPIRY_SECONDS=7200
FRONTEND_BASE_URL=https://yoursite.com
